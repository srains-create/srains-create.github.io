<%- include("partials/header") %>

<main class="admin-dashboard">

    <h2>Welcome to the Famous Quotes Admin Section</h2>

    <p>
        Use the options below to manage authors and quotes.
    </p>

    <section class="dashboard-actions">

        <div class="dashboard-card">
            <form action="/admin/authors/add">
                <button type="submit">Add Authors</button>
            </form>
        </div>

        <div class="dashboard-card">
            <form action="/admin/quotes/add">
                <button type="submit">Add Quotes</button>
            </form>
        </div>

        <div class="dashboard-card">
            <form action="/authors">
                <button type="submit">List Authors</button>
            </form>
        </div>

        <div class="dashboard-card">
            <form action="/quotes">
                <button type="submit">List Quotes</button>
            </form>
        </div>

    </section>

</main>

<%- include("partials/footer") %>